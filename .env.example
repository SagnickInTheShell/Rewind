# Copy to .env to override config values. Format: REWIND__<SECTION>__<KEY>=<yaml value>
# REWIND_CONFIG=backend/config/default.yaml
# REWIND__APP__LOG_LEVEL=DEBUG
# REWIND__VIDEO__FPS_PROCESSED=5.0
# REWIND__PERCEPTION__YOLO_MODEL=yolov8s.pt
# REWIND__APP__BLUR_HEADS_IN_EXPORTS=true
# Frontend dev proxy target
# REWIND_BACKEND_URL=http://127.0.0.1:8000
